      180.0
    ],
    "zoom_cumulative_range": [
      0.25,
      4.0
    ],
    "zoom_step_range": [
      0.25,
      4.0
    ],
    "pan_margin_mm": 50.0,
    "default_view_direction": "anterior",
    "view_directions": {
