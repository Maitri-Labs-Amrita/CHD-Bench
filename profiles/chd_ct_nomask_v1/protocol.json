    "server_name": "slicer-mcp",
    "instructions_title": "CHD cardiac CT viewer.",
    "tools": [
      "reset_view",
      "bookmark_view",
      "submit_report",
      "set_slice",
      "scroll_slice",
      "set_window_preset",
